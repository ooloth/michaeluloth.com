#!/usr/bin/env bash
# Prepares a fresh Amp orb to build, test and run this repo.
# Runs once per fresh orb (and again on a stale snapshot), so every step is idempotent.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# CI installs the Node version in .nvmrc, so the orb uses the same one instead of
# the base image's Node.
node_version="$(tr -d '[:space:]' < .nvmrc)"
node_dir="$HOME/.local/share/node/node-${node_version}-linux-x64"

install_node() {
  if [[ -x "$node_dir/bin/node" ]]; then
    echo "Node ${node_version} already installed at $node_dir"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  local tarball="node-${node_version}-linux-x64.tar.xz"
  local base="https://nodejs.org/dist/${node_version}"
  curl -fsSL --retry 3 -o "$tmp/$tarball" "$base/$tarball"
  curl -fsSL --retry 3 -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
  (cd "$tmp" && grep " ${tarball}\$" SHASUMS256.txt | sha256sum -c -)
  mkdir -p "$(dirname "$node_dir")"
  tar -xJf "$tmp/$tarball" -C "$(dirname "$node_dir")"
  rm -rf "$tmp"
}

# Amp and supervised services start in login shells, so the pinned Node goes on
# PATH there. The hook is scoped to this checkout so other repos keep the image's Node.
persist_node_path() {
  local marker="# michaeluloth.com: Node from .nvmrc"
  if grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    echo "PATH hook already present"
    return
  fi
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD" in
  "$repo_root"|"$repo_root"/*)
    _mu_node_bin="\$HOME/.local/share/node/node-\$(tr -d '[:space:]' < "$repo_root/.nvmrc")-linux-x64/bin"
    case ":\$PATH:" in
      *":\$_mu_node_bin:"*) ;;
      *) [ -d "\$_mu_node_bin" ] && export PATH="\$_mu_node_bin:\$PATH" ;;
    esac
    unset _mu_node_bin
    ;;
esac
EOF
}

install_deps() {
  export PATH="$node_dir/bin:$PATH"
  echo "Using node $(node --version), npm $(npm --version)"
  # npm ci deletes node_modules first, so skip it when the restored tree already
  # matches the lockfile and was built by this Node version.
  local stamp="node_modules/.orb-setup-stamp"
  local want
  want="${node_version} $(sha256sum package-lock.json | cut -d' ' -f1)"
  if [[ -f "$stamp" && "$(cat "$stamp")" == "$want" ]]; then
    echo "node_modules matches package-lock.json and Node ${node_version}"
    return
  fi
  npm ci --no-audit --no-fund
  echo "$want" > "$stamp"
}

step "Install Node ${node_version}" install_node
step "Persist Node PATH for login shells" persist_node_path
step "Install npm dependencies" install_deps
